# ============================================================
#  Contoh konfigurasi run. Salin ke .env lalu sesuaikan:
#     cp .env.example .env
#  Semua baris opsional — dihapus/dikosongkan = grid PENUH.
# ============================================================

# Subset arsitektur (pisah koma). Penuh:
#   resnet50,convnext_tiny,efficientnetv2_s,vit_small,swin_tiny
# CVL_ARCHS=resnet50

# Level ablasi data (halaman latih/penulis). Penuh: 1,2,3,4
# Token "full" (semua halaman) masih didukung tapi tidak lagi dipakai —
# ukurannya ≈ L4, jadi redundan.
# CVL_LEVELS=1,4

# Seed. Penuh: 0,1,2
# CVL_SEEDS=0

# Mode. Penuh: pretrained,scratch
# CVL_MODES=pretrained

# Batasi jumlah penulis (kosong = semua). Buat smoke test cepat.
# CVL_MAX_WRITERS=10

# Override hyperparameter (kosong = pakai configs/default.yaml)
# CVL_PRETRAINED_EPOCHS=2
# CVL_SCRATCH_EPOCHS=2
# CVL_BATCH_SIZE=32
